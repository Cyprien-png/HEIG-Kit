{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "heigkit": ["./kit/index.ts"],
      "@heigkit/video": ["./examples/mux.tsx"]
    }
  },
  "include": ["*.ts", "*.tsx", "kit", "examples"]
}
