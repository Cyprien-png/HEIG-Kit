# SWITCH edu-ID credentials (the ones used on GAPS / Cyberlearn)
HEIG_EMAIL=firstname.lastname@heig-vd.ch
HEIG_PASSWORD=change-me

# Optional: your GAPS student id, only needed if it cannot be detected automatically
# GAPS_STUDENT_ID=

# Optional: local folders to index in the knowledge base (npm run ingest), separated by ":" (";" on Windows),
# organized as <folder>/<COURSE>/<chapter>/<file>
# RAG_LOCAL_DIRS=

# Optional: the knowledge base indexes the Cyberlearn courses of your GAPS timetable (your curriculum) by default.
# Comma-separated course codes, ids or parts of names to add or to leave out:
# RAG_EXTRA_COURSES=
# RAG_EXCLUDE_COURSES=

# Optional: where generated documents and videos go (default: ~/Documents/HEIG-Kit)
# HEIG_OUTPUT_DIR=
