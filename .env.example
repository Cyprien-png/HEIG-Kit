# SWITCH edu-ID credentials (the ones used on GAPS / Cyberlearn)
HEIG_EMAIL=firstname.lastname@heig-vd.ch
HEIG_PASSWORD=change-me

# Optional: your GAPS student id, only needed if it cannot be detected automatically
# GAPS_STUDENT_ID=

# Optional: local folders to index in the knowledge base (npm run ingest), separated by ":" (";" on Windows),
# organized as <folder>/<COURSE>/<chapter>/<file>
# RAG_LOCAL_DIRS=

# Optional: a GitHub token (fine-grained, read-only on the course repositories) for `npm run repos`. Without it, git uses
# your own account (credential helper, keychain). Required on the remote server, whose container has no git account.
# HEIG_GITHUB_TOKEN=

# Optional: the knowledge base indexes the Cyberlearn courses of your GAPS timetable (your curriculum) by default.
# Comma-separated course codes, ids or parts of names to add or to leave out:
# RAG_EXTRA_COURSES=
# RAG_EXCLUDE_COURSES=

# Optional: where generated documents and videos go (default: ~/Documents/HEIG-Kit, subfolders documents and videos)
# HEIG_OUTPUT_DIR=
# HEIG_DOCUMENTS_DIR=
# HEIG_VIDEOS_DIR=

# Optional: where course data and the login session are kept (default: data/ and .cache/ in this folder)
# HEIG_DATA_DIR=
# HEIG_CACHE_DIR=

# Optional: use a remote HEIG-Kit server from this computer (docs/server.md): its knowledge base, calendar, flashcards,
# corrections and library. Then `npm run remote -- login`.
# HEIG_REMOTE_URL=https://heig.example.org

# Remote server only (npm run server, see docs/server.md). It refuses to start if one of these is missing or weak.
# Its accounts are created on the machine: npm run users -- add prenom.nom@heig-vd.ch (docs/accounts.md).
# HEIG_JWT_SECRET=output-of-openssl-rand-hex-32
# HEIG_PUBLIC_URL=https://heig.example.org
# Change the version to revoke every token and download link of every account at once.
# HEIG_JWT_VERSION=1
# HEIG_JWT_DAYS=90
# HEIG_LINK_MINUTES=15
# Behind a reverse proxy, so that login attempts are counted per real client.
# HEIG_TRUST_PROXY=1
# How often the server fetches GAPS and Cyberlearn for each account (minutes, 0 disables).
# HEIG_SYNC_MINUTES=60
