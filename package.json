{
  "name": "heig-kit",
  "version": "0.2.0",
  "private": true,
  "description": "Toolkit and Claude Code plugin giving HEIG-VD students access to their own academic information through SWITCH edu-ID",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "schedule": "tsx src/cli.ts schedule",
    "deadlines": "tsx src/cli.ts deadlines",
    "courses": "tsx src/cli.ts courses",
    "course": "tsx src/cli.ts course",
    "ingest": "tsx src/cli.ts ingest",
    "typecheck": "tsc --noEmit",
    "aliases": "tsx scripts/aliases.ts",
    "rag:start": "docker compose -f rag/compose.yml up -d --wait",
    "rag:stop": "docker compose -f rag/compose.yml --profile ingest down",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.7",
    "fetch-cookie": "^3.2.0",
    "node-ical": "^0.27.3",
    "pg": "^8.23.1",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
